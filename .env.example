# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=YourBotUsername
# Optional Telegym/mock Bot API base URL for E2E tests, e.g. http://127.0.0.1:5678
TELEGRAM_API_URL=
ADMIN_TELEGRAM_IDS=123456789,987654321

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=academic
POSTGRES_SCHEMA=student_platform
POSTGRES_SSLMODE=disable  # production: require
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/academic
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Optional Redis Configuration
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Background Tasks & Outbox
TASK_WORKER_ENABLED=true
TASK_WORKER_POLL_INTERVAL=2.0
BOT_POLLING_ENABLED=true
